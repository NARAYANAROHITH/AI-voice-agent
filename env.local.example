# ── AI Model Providers (BYOK) ──────────────────────────────────────────────────
# Required: OpenAI API key (for GPT-4o multilingual voice reception)
NEXT_LLM_API_KEY=

# Required: Sarvam AI API key (for Saaras STT and Bulbul TTS: Hindi, Telugu, English)
NEXT_SARVAM_API_KEY=

# Optional: Public URL for Agora webhook callbacks to reach restaurant tools
# (e.g. https://your-domain.vercel.app or ngrok tunnel URL for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database & Restaurant Config ──────────────────────────────────────────────
# Required: PostgreSQL connection string (Neon serverless or local)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Restaurant identifier (must match seeded restaurant ID)
NEXT_RESTAURANT_ID=spice-garden-main

# ── Dashboard Authentication ──────────────────────────────────────────────────
# NextAuth v5 configuration for restaurant staff dashboard
NEXTAUTH_SECRET=
NEXT_DASHBOARD_USER=admin
NEXT_DASHBOARD_PASS=
