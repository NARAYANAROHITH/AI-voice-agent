# Reservations backend (optional)
# Base URL of the service that answers GET /availability?date=&time=&party_size=.
# When unset, the agent runs without the check_availability tool and never
# promises a table. Keep this endpoint fast — it runs inside the voice turn.
NEXT_RESERVATIONS_API_URL=

# Restaurant facts injected into the system prompt (optional)
RESTAURANT_HOURS=11:30 AM to 10 PM, Tuesday to Sunday
RESTAURANT_ADDRESS=the downtown Spice Garden location
